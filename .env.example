# Docker Compose and Spring Boot read .env at the repository root.
# Use plain KEY=value entries without shell export or surrounding quotes.
# Spring Boot imports this file as Java properties; escape backslashes as needed.
SERVER_PORT=8080
POSTGRES_DB=football_ai
POSTGRES_USER=football_ai
POSTGRES_PASSWORD=replace-with-a-local-password
POSTGRES_PORT=5432
# Backend running in the IDE. Compose sets postgres:5432 inside the Docker network.
DB_HOST=localhost
DB_PORT=5432
# Host ports for the containerized application; container ports remain 8080 and 80.
BACKEND_PORT=8080
FRONTEND_PORT=3000
# Disposable local test service (Compose profile test), separate from development data.
TEST_DB_HOST=localhost
TEST_DB_PORT=5433
TEST_DB_PASSWORD=local-test-only
# Vite proxy destination when running npm run dev; not exposed as a browser secret.
DEV_API_TARGET=http://localhost:8080
